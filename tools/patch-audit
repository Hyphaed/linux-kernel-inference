"""patch-audit , the pre-send gate for everything in upstream-candidates/outbox.

One command, run before any `git send-email`, because the alternative is
remembering four of them in the right order and from the right directory.

What it runs, and why each one exists:

  checkpatch.pl --strict     the kernel's own style gate. MUST be invoked from
                             inside linux/ , from the repo root it reports a
                             false trailing-whitespace ERROR on every patch.
  authorship suite           From:, exactly one Signed-off-by, sign-off above
                             the '---' separator (git am silently drops
                             trailers below it), and the Assisted-by tag.
  threading                  a v2+ patch must carry In-Reply-To for the version
                             it replaces, or it starts a new thread , which is
                             worse than not resending.
  duplicate guard            refuses when two files in the outbox declare the
                             same Subject, the shape that put two copies of
                             0021 v2 on linux-pci on 2026-08-20.

Exit 0 = safe to send. Anything else = do not send.
"""
from __future__ import annotations

import re
import subprocess
import sys
from collections import defaultdict
from pathlib import Path

REPO = Path(__file__).resolve().parents[1]
OUTBOX = REPO / "upstream-candidates" / "outbox"
LINUX = REPO / "linux"


def _subject(text: str) -> str:
    m = re.search(r"^Subject: (.*)$", text, flags=re.M)
    return m.group(1).strip() if m else ""


def main() -> int:
    patches = sorted(OUTBOX.glob("*.patch"))
    if not patches:
        print("outbox is empty , nothing to audit")
        return 0

    fails: list[str] = []

    # ── duplicate subjects ────────────────────────────────────────────────
    by_subject: dict[str, list[str]] = defaultdict(list)
    for p in patches:
        by_subject[_subject(p.read_text(errors="replace"))].append(p.name)
    for subj, names in by_subject.items():
        if len(names) > 1:
            fails.append(f"two outbox files share Subject {subj!r}: {', '.join(names)} "
                         f", sending the directory would post both")

    # ── per-patch ─────────────────────────────────────────────────────────
    for p in patches:
        text = p.read_text(errors="replace")
        subj = _subject(text)
        rel = p.relative_to(REPO)

        if LINUX.is_dir():
            r = subprocess.run(
                ["perl", "scripts/checkpatch.pl", "--strict", "--no-summary",
                 str(Path("..") / rel)],
                cwd=LINUX, capture_output=True, text=True, timeout=180)
            errs = [ln for ln in r.stdout.splitlines() if ln.startswith("ERROR")]
            if errs:
                fails.append(f"{p.name}: checkpatch ERROR , " + errs[0][:110])
        else:
            print(f"  note: {LINUX} absent , checkpatch skipped for {p.name}")

        m = re.search(r"^\[PATCH v(\d+)\]", subj) or re.search(r"v(\d+)\]", subj)
        if m and int(m.group(1)) >= 2 and "In-Reply-To:" not in text:
            fails.append(f"{p.name}: {subj!r} is a v{m.group(1)} with no "
                         f"In-Reply-To , it would start a new thread")

    # ── authorship suite ──────────────────────────────────────────────────
    r = subprocess.run([sys.executable, "-m", "pytest",
                        "tests/test_patch_authorship.py", "-q"],
                       cwd=REPO, capture_output=True, text=True, timeout=300)
    if r.returncode != 0:
        tail = [ln for ln in r.stdout.splitlines() if ln.startswith("FAILED")][:4]
        fails.append("authorship suite failed:\n    " + "\n    ".join(tail or ["see pytest output"]))

    print(f"\naudited {len(patches)} patch(es) in {OUTBOX.relative_to(REPO)}")
    if not fails:
        print("all gates green , safe to send")
        return 0
    print(f"\n{len(fails)} problem(s):\n")
    for f in fails:
        print(f"  - {f}")
    print("\nDo not send until these are clear.")
    return 1


if __name__ == "__main__":
    sys.exit(main())
