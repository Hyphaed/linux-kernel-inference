+	ref->shard_first = cid_to_shard[base];
+	if (likely(nr_cids))
+		ref->shard_end = cid_to_shard[base + nr_cids - 1] + 1;
+	else
+		ref->shard_end = ref->shard_first;
+
+	return 0;
+}
