# io_uring + full BPF stack (BTF/CO-RE + JIT default on)
CONFIG_IO_URING=y
# ZCRX (zero-copy receive) + its NET_DEVMEM/PAGE_POOL deps already ship =y in
# the Ubuntu base config; pinned here (same rationale as 21-ai-gpu-mem.config)
# so a future fragment or `make olddefconfig` cannot silently demote the
# zero-copy path GreenBoost's cluster/feeder network fabric and NVMe T3
# streaming could use.
CONFIG_IO_URING_ZCRX=y
CONFIG_NET_DEVMEM=y
CONFIG_PAGE_POOL=y
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_JIT_DEFAULT_ON=y
CONFIG_HAVE_EBPF_JIT=y
CONFIG_BPF_EVENTS=y
CONFIG_BPF_LSM=y
# CONFIG_BPF_LSM=y alone does NOT make the BPF LSM usable. The symbol compiles
# the hooks in; CONFIG_LSM is the string that decides which LSMs are actually
# initialised, and Ubuntu's base config omits `bpf` from it. Built that way,
# 7.1.10 boots with /sys/kernel/security/lsm reading
# "lockdown,capability,landlock,yama,apparmor,ima,evm" and systemd reports
#
#   bpf-restrict-fs: BPF LSM hook not enabled in the kernel, BPF LSM not supported.
#
# every boot. Same shape as the =n-vs-select pitfalls in CLAUDE.md: the
# fragment set its symbol, the symbol landed, and the capability never arrived,
# because what decides is a string the fragment didn't touch. Keep the two
# lines together — tests/test_fragment_wiring.py fails if one appears without
# the other. (ima/evm are appended by the kernel, not listed here.)
CONFIG_LSM="landlock,lockdown,yama,integrity,apparmor,bpf"
CONFIG_BPF_KPROBE_OVERRIDE=y
# DEBUG_INFO_BTF depends on !DEBUG_INFO_SPLIT && !DEBUG_INFO_REDUCED (see
# lib/Kconfig.debug) — REDUCED/SPLIT were silently making olddefconfig drop
# BTF entirely (confirmed 2026-07-09: validated .config showed
# DEBUG_INFO_BTF unset despite this file requesting =y). BTF is required for
# greenboost_all/greenboost's eBPF CO-RE tracer, so it wins; debug .deb size
# grows as the tradeoff (REDUCED existed specifically to shrink it).
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y
CONFIG_KPROBES=y
CONFIG_UPROBES=y
CONFIG_FTRACE=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_FUNCTION_GRAPH_TRACER=y
