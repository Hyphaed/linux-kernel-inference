# io_uring + full BPF stack (BTF/CO-RE + JIT default on)
CONFIG_IO_URING=y
# ZCRX (zero-copy receive) + its NET_DEVMEM/PAGE_POOL deps already ship =y in
# the Ubuntu base config; pinned here (same rationale as 21-ai-gpu-mem.config)
# so a future fragment or `make olddefconfig` cannot silently demote the
# zero-copy path GreenBoost's cluster/feeder network fabric and NVMe T3
# streaming could use.
CONFIG_IO_URING_ZCRX=y
CONFIG_NET_DEVMEM=y
CONFIG_PAGE_POOL=y
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_JIT_DEFAULT_ON=y
CONFIG_HAVE_EBPF_JIT=y
CONFIG_BPF_EVENTS=y
CONFIG_BPF_LSM=y
CONFIG_BPF_KPROBE_OVERRIDE=y
# DEBUG_INFO_BTF depends on !DEBUG_INFO_SPLIT && !DEBUG_INFO_REDUCED (see
# lib/Kconfig.debug) — REDUCED/SPLIT were silently making olddefconfig drop
# BTF entirely (confirmed 2026-07-09: validated .config showed
# DEBUG_INFO_BTF unset despite this file requesting =y). BTF is required for
# greenboost_all/greenboost's eBPF CO-RE tracer, so it wins; debug .deb size
# grows as the tradeoff (REDUCED existed specifically to shrink it).
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y
CONFIG_KPROBES=y
CONFIG_UPROBES=y
CONFIG_FTRACE=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_FUNCTION_GRAPH_TRACER=y
