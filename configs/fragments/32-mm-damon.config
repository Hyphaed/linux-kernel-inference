# DAMON (Data Access MONitoring) — cold-page/access-pattern detection.
# Confirmed absent from every base config 7.0.0 through 7.1.5 (# CONFIG_DAMON
# is not set). Mechanism-only, matching this repo's zswap/THP posture of
# making a capability available and letting the operator/GreenBoost decide
# policy at runtime rather than baking in a fixed reclaim scheme:
CONFIG_DAMON=y
CONFIG_DAMON_VADDR=y                      # per-process virtual-address monitoring
CONFIG_DAMON_PADDR=y                      # physical-address monitoring (system-wide)
CONFIG_DAMON_SYSFS=y                      # runtime scheme config via
                                           # /sys/kernel/mm/damon/admin/kdamonds/
# Deliberately NOT enabling CONFIG_DAMON_RECLAIM / CONFIG_DAMON_LRU_SORT —
# each is a single hardcoded scheme; DAMON_SYSFS alone gives full runtime
# flexibility to define custom access/quota/action schemes per kdamond
# instance, a better fit for identifying cold model-weight/KV-cache pages
# ahead of or alongside GreenBoost's own T1/T2/T3 tiering than either canned
# policy. See the project notes, "DAMON runtime setup", for how to arm a
# scheme via sysfs.
CONFIG_DAMON_STAT=y                       # lightweight always-on access-rate
                                           # stats (no reclaim action); free
                                           # visibility, depends on DAMON_PADDR
