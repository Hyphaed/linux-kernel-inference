# DRM/KMS plumbing required for NVIDIA proprietary driver + GNOME/Wayland
#
# IBT (Indirect Branch Tracking) must be OFF for Nvidia proprietary DKMS.
# The Nvidia open kernel module is compiled without -fcf-protection (GCC IBT
# support), so the .ko lacks ENDBR instructions at indirect call sites. With
# CONFIG_X86_KERNEL_IBT=y the kernel fires a silent #CP fault on GPU init,
# causing a black screen hang at boot. Override the mitigation fragment here.
# Tracked: https://github.com/NVIDIA/open-gpu-kernel-modules/issues/
CONFIG_X86_KERNEL_IBT=n
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_TTM=y
CONFIG_DRM_GEM_SHMEM_HELPER=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_FBDEV_OVERALLOC=100
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_PANEL=y
CONFIG_DRM_BUDDY=y
CONFIG_DRM_DISPLAY_HELPER=y
CONFIG_DRM_DISPLAY_HDMI_HELPER=y
CONFIG_DRM_DISPLAY_DP_HELPER=y
# Input/HID broad coverage for Steam controllers, generic gamepads
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_JOYDEV=m
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_HID_STEAM=m
CONFIG_HID_NINTENDO=m
CONFIG_HID_PLAYSTATION=m
CONFIG_HID_LOGITECH=m
CONFIG_HID_LOGITECH_DJ=m
CONFIG_HID_LOGITECH_HIDPP=m
CONFIG_HID_MICROSOFT=m
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_SUPPORT=y
