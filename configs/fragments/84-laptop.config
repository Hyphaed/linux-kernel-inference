# Laptop platform essentials — battery, suspend, wifi, touchpad, backlight.
# Most of these are =m in the Ubuntu baseline; this fragment pins them so the
# module-stripping passes and march=native builds don't accidentally lose them.
CONFIG_SUSPEND=y
CONFIG_PM_SLEEP=y
# Battery and AC power supply
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_AC=y
CONFIG_ACPI_VIDEO=m
# Backlight control
CONFIG_BACKLIGHT_CLASS_DEVICE=y
# Touchpad / HID over I2C (OMEN uses i2c-hid-acpi)
CONFIG_I2C_HID_ACPI=m
CONFIG_HID_MULTITOUCH=m
# Realtek RTL8852BE wifi (OMEN 16 ap0xxx)
CONFIG_RTW89_8852BE=m
# Bluetooth (RTL BT co-chip)
CONFIG_BT=m
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_RTL=m
# Wired ethernet (RTL8111)
CONFIG_R8169=m
# HP OMEN platform WMI (fan control, LEDs, thermal modes)
CONFIG_HP_WMI=m
