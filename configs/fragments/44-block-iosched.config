# Block-layer I/O schedulers, pinned explicitly (2026-10-28).
#
# Ubuntu's base config ships kyber and bfq as modules and no hyphaed fragment
# pinned them, so a base-config change could drop either without anyone
# noticing. Behaviour doesn't change: NVMe still defaults to `none`. These only
# keep `echo kyber > /sys/block/nvme0n1/queue/scheduler` possible. The module
# autoloads on that write, which is why /sys/block/*/queue/scheduler lists only
# `none mq-deadline` until the first time kyber is selected.
#
# mq-deadline stays built in: the xanmod patches (front-merge, write-prio) tune
# it, and it is the fallback for SATA and USB disks.
# bfq is for the USB / spinning external drives, not the NVMe.
CONFIG_MQ_IOSCHED_DEADLINE=y
CONFIG_MQ_IOSCHED_KYBER=m
CONFIG_IOSCHED_BFQ=m
