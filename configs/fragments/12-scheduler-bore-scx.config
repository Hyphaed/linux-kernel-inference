# BORE scheduler + sched_ext for userspace schedulers (scx_lavd, scx_bpfland, scx_rusty)
CONFIG_SCHED_BORE=y
CONFIG_SCHED_CLASS_EXT=y
CONFIG_SCHED_AUTOGROUP=y
CONFIG_SCHED_MM_CID=y
CONFIG_SCHED_CORE=y
CONFIG_SCHED_DEBUG=y
CONFIG_SCHEDSTATS=y
CONFIG_CFS_BANDWIDTH=y
# Group scheduling (cgroup v2 CPU controller)
CONFIG_FAIR_GROUP_SCHED=y
# RT group scheduling is incompatible with cgroup-v2-unified userspace: it zeroes
# rt_runtime for every non-root task group, so rtkit/PipeWire cannot obtain SCHED_RR.
# Boot 2026-08-17 on 7.1.8-hyphaed logged 20+ "rtkit-daemon: Failed to make ourselves
# RT: Operation not permitted" — audio ran without RT priority. Ubuntu's own base
# config (config-7.0.0-29-generic, config-7.1.5-070105-generic) leaves this unset.
# Do not re-enable.
# CONFIG_RT_GROUP_SCHED is not set
