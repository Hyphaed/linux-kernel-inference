# AI/GPU memory substrate — NVIDIA UVM (HMM), P2P DMA, PSI telemetry.
# All ship =y in the Ubuntu base config; pinned here so a future fragment or
# `make olddefconfig` cannot silently demote the NVIDIA-UVM / GreenBoost path.
CONFIG_HMM_MIRROR=y                       # nvidia-uvm HMM-based managed memory
CONFIG_DEVICE_PRIVATE=y                   # device-private pages for UVM migration
CONFIG_ZONE_DEVICE=y                      # ZONE_DEVICE backing for HMM
CONFIG_PCI_P2PDMA=y                       # peer-to-peer DMA (GPU<->NVMe, GreenBoost T3)
CONFIG_DMABUF_HEAPS=y                     # dma-buf heaps consumed by greenboost.ko
CONFIG_USERFAULTFD=y                      # managed-memory fault handling
CONFIG_PSI=y                              # pressure stall info (gb_orchestrator PSI io)
# CONFIG_PSI_DEFAULT_DISABLED is not set  # PSI active without psi=1 cmdline
CONFIG_TRANSPARENT_HUGEPAGE=y             # THP available (greenboost flips to =always at runtime)
