# PCIe/DMA byte-reduction substrate for local AI inference — see
# docs/research/spark-parity-survey.md for the full rationale (closing the
# ~4 GB VRAM gap on Qwen3.6-27B-MTP Q4_K_M by cutting bytes crossed over
# PCIe rather than link-level compression, which the protocol does not
# support). Follows 21-ai-gpu-mem.config's pattern: pin what already ships
# =y so a future fragment or `make olddefconfig` cannot silently demote it,
# plus the one genuinely new symbol this substrate needs.
#
# Verified against /boot/config-7.1.7-hyphaed (2026-08-10): every "pin"
# entry below already reads =y on this box; only ZRAM_MULTI_COMP is new.

# Already =y — pinned so nothing downstream can demote them:
CONFIG_PCI_P2PDMA=y                       # GPU<->NVMe P2P DMA (GDS path, GreenBoost T3)
CONFIG_UDMABUF=y                          # userspace dma-buf backing (compressed-descriptor RFC testing)
CONFIG_IO_URING_ZCRX=y                    # zero-copy receive; NVMe-shard read path
CONFIG_PCI_REALLOC_ENABLE_AUTO=y          # ReBAR — confirmed live: 16G prefetchable BAR on a 12G card
CONFIG_ZRAM_WRITEBACK=y                   # zram->NVMe writeback, feeds the T3 multi-tier scheme below
CONFIG_CRYPTO_DEFLATE=y                   # deflate codec available to zswap/zram

# Genuinely new (# CONFIG_ZRAM_MULTI_COMP is not set on this box today):
# enables a fast primary (lz4) + denser secondary (zstd) recompression pass
# for idle zram pages instead of one fixed algorithm for everything —
# see docs/research/spark-parity-survey.md's multi-tier compressed memory
# track. zram itself stays =m (systemd-zram-generator loads it; no reason
# to build it in).
CONFIG_ZRAM_MULTI_COMP=y

# Deliberately NOT added here:
#   CONFIG_DMABUF_MOVE_NOTIFY — not user-selectable (select'ed by amdgpu,
#     which 61-no-amdgpu-no-nouveau.config disables on this box).
#   CONFIG_MEMORY_TIERING — requires multiple NUMA nodes; this box reports
#     numa_nodes: 1 (single-socket Raptor Lake, no CXL).
