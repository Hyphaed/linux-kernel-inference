# AMD Ryzen AI 9 365 "Strix Point" specific modules.
# Mirrors the modules loaded on the stock Ubuntu 7.0 kernel on this machine.
# Verify symbol names against the target kernel tree before using:
#   grep -r "config AMD_PMC\|config AMD_PMF\|config AMD_SFH_HID\|config DRM_ACCEL_AMDXDNA" build/linux-7.1.3/
CONFIG_X86_AMD_PSTATE=y
CONFIG_AMD_PMC=m
CONFIG_AMD_PMF=m
CONFIG_AMD_SFH_HID=m
CONFIG_DRM_ACCEL_AMDXDNA=m
CONFIG_AMD_ATL=m
CONFIG_EDAC_AMD64=m
CONFIG_EDAC_DECODE_MCE=m
CONFIG_KVM_AMD=m
CONFIG_SND_AMD_ACP_CONFIG=m
CONFIG_SND_SOC_SOF_AMD_ACP70=m
# AMD hardware RNG
CONFIG_HW_RANDOM_AMD=m
