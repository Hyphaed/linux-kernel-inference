# AMD Ryzen AI 9 365 "Strix Point" specific modules.
# Mirrors the modules loaded on the stock Ubuntu 7.0 kernel on this machine.
# Verify symbol names against the target kernel tree before using:
#   grep -r "config AMD_PMC\|config AMD_PMF\|config AMD_SFH_HID\|config DRM_ACCEL_AMDXDNA" build/linux-7.1.3/
CONFIG_X86_AMD_PSTATE=y
CONFIG_AMD_PMC=m
CONFIG_AMD_PMF=m
CONFIG_AMD_SFH_HID=m
CONFIG_DRM_ACCEL_AMDXDNA=m
CONFIG_AMD_ATL=m
CONFIG_EDAC_AMD64=m
CONFIG_EDAC_DECODE_MCE=m
CONFIG_KVM_AMD=m
CONFIG_SND_AMD_ACP_CONFIG=m
CONFIG_SND_SOC_SOF_AMD_ACP70=m
# AMD hardware RNG
CONFIG_HW_RANDOM_AMD=m

# ── Added 2026-08-27 after re-reading 7.2 with the laptop in mind ────────────
# Every symbol below was already correct on this machine, by inheritance from
# Canonical's base config. None of it was pinned. That is precisely the state
# CLAUDE.md records for ITMT and HFI — "fine *by luck*, and would have
# silently lost both if Ubuntu ever changed its base". Pinning costs nothing
# and removes the luck.

# ITMT on AMD. This became load-bearing at 7.2 rather than being a no-op:
# drivers/cpufreq/amd-pstate.c now calls sched_set_itmt_core_prio() with the
# CPU's prefcore ranking and sched_set_itmt_support() once all CPUs have
# initialised (amd-pstate.c:915, :1670). Strix Point is 4 Zen5 + 6 Zen5c, so
# the scheduler genuinely needs to know which cores clock higher -- the same
# asym-packing machinery 80-raptorlake-intel.config turns on for the P/E split
# on machine 1. SCHED_MC_PRIO is `default y` and would land anyway; it is
# pinned here because "would land anyway" is how the ITMT lesson started.
#
# Note SCHED_MC_PRIO does `select X86_AMD_PSTATE if CPU_SUP_AMD && ACPI`, so
# it and the amd-pstate lines above reinforce each other rather than fight.
CONFIG_SCHED_MC=y
CONFIG_SCHED_MC_PRIO=y

# amd-pstate mode 3 = Active (EPP). 1=Disabled, 2=Passive, 4=Guided.
# This is the symbol that makes the laptop behave like the desktop: machine 1
# runs intel_pstate in active mode with an energy_performance_preference knob,
# and `powerprofilesctl set performance` drives exactly that. Mode 3 gives
# amd-pstate the same EPP knob, so one command means one thing on both boxes.
# It matters: a 2026-08-27 boot audit found machine 1 sitting in power-saver
# with EPP=power on all 32 threads, and the fix was a powerprofilesctl call.
# That fix only transfers to the laptop if amd-pstate is in active mode.
CONFIG_X86_AMD_PSTATE_DEFAULT_MODE=3

# AMD_PMF is already =m above, and =m alone does not make it build. It
# `depends on ACPI && PCI && POWER_SUPPLY && AMD_NODE && TEE && AMDTEE` and
# `select ACPI_PLATFORM_PROFILE`. Drop any one of those and the =m above is a
# silent no-op -- pitfall #2, with the twist that the symbol here is real and
# the *dependency* is what goes missing. PMF is what drives the firmware-side
# platform profile on Strix Point, i.e. the half of powerprofilesctl that is
# not CPU frequency.
#
# TEE is a `menuconfig`, not a `config`. CLAUDE.md's symbol-existence recipe
# greps for `^\s*config\s+FOO$` and reports TEE as nonexistent, which is a
# false negative -- see the note added there.
CONFIG_TEE=m
CONFIG_AMDTEE=m
CONFIG_AMD_NODE=y
CONFIG_ACPI_PLATFORM_PROFILE=y
