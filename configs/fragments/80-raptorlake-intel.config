# Raptor Lake / Alder Lake hybrid optimizations
#
# 2026-08-17: this fragment previously carried CONFIG_INTEL_ITMT,
# CONFIG_INTEL_THREAD_DIRECTOR and CONFIG_INTEL_HFI. None of those three Kconfig
# symbols exist — they were silent no-ops. The real mechanisms are
# CONFIG_SCHED_MC_PRIO (that IS ITMT: it turns on the sched-domain priority
# ordering the Thread Director feeds) and CONFIG_INTEL_HFI_THERMAL (the HFI
# driver itself). Both are pinned explicitly below rather than being inherited
# from Ubuntu's base by luck. See the project notes, "Config fragment pitfalls".
CONFIG_INTEL_HFI_THERMAL=y
# ITMT / Thread Director core-priority ordering.
CONFIG_SCHED_MC_PRIO=y
# E-core L2 clusters as a scheduling domain.
CONFIG_SCHED_CLUSTER=y
CONFIG_INTEL_IDLE=y
CONFIG_INTEL_RAPL=m
CONFIG_INTEL_TURBO_MAX_3=y
CONFIG_PERF_EVENTS_INTEL_UNCORE=y
CONFIG_PERF_EVENTS_INTEL_RAPL=m
CONFIG_PERF_EVENTS_INTEL_CSTATE=m
CONFIG_X86_INTEL_LPSS=y
CONFIG_X86_INTEL_TSX_MODE_OFF=y
# NOTE: CONFIG_X86_AMD_PSTATE=n used to live here and NEVER took effect —
# arch/x86/Kconfig does `select X86_AMD_PSTATE if CPU_SUP_AMD && ACPI`, and a
# Kconfig select overrides a fragment's =n. It is now handled properly by the
# generated configs/generated/90-machine-topology.config, which sets
# CONFIG_CPU_SUP_AMD=n on Intel builds and thereby breaks the select condition.
# Do not re-add it here.
# Use modern Intel pstate as primary driver
CONFIG_X86_INTEL_PSTATE=y
# Enable schedutil + p-states fast switching for sub-ms freq response
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
