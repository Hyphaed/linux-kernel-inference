# AMD iGPU (Radeon 880M / Strix Point) — drives the laptop panel via amdgpu.
# Required when the CPU has an integrated Radeon that handles display output.
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_AMD_DC=y
CONFIG_DRM_AMDGPU_USERPTR=y
CONFIG_HSA_AMD=y
# HDMI audio through the AMD display engine
CONFIG_SND_HDA_CODEC_HDMI=m
