# Disable nouveau (fights nvidia-drm on Wayland) and AMDGPU (no AMD GPU)
CONFIG_DRM_NOUVEAU=n
CONFIG_DRM_NOUVEAU_BACKLIGHT=n
CONFIG_DRM_AMDGPU=n
CONFIG_DRM_AMDGPU_SI=n
CONFIG_DRM_AMDGPU_CIK=n
CONFIG_DRM_AMD_DC=n
CONFIG_DRM_RADEON=n
# Intel iGPU is disabled by igfx_off cmdline but keep module available
CONFIG_DRM_I915=m
CONFIG_DRM_I915_GVT=n
