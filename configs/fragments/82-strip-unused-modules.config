# Strip modules that will never load on this workstation.
# Target: i9-14900KF, RTX 5070, 64 GB DDR4, GNOME+Wayland, VMware, no AMD, no mobile.
# Each disable is annotated with the reason so a future maintainer can reverse it safely.

# ── Legacy telephony / WAN protocols ─────────────────────────────────────────
# ISDN, ATM, X.25, LAPB — no ISDN adapters; no WAN cards
CONFIG_ISDN=n
CONFIG_ATM=n
CONFIG_X25=n
CONFIG_LAPB=n

# ── Amateur radio / AX.25 ────────────────────────────────────────────────────
CONFIG_HAMRADIO=n
CONFIG_AX25=n

# ── NFC ──────────────────────────────────────────────────────────────────────
# No NFC hardware on this board or in the VM fleet
CONFIG_NFC=n

# ── Legacy input / bus hardware ──────────────────────────────────────────────
# Floppy controller — no floppy drive
CONFIG_BLK_DEV_FD=n
# Parallel port + parport-attached devices — no printer / LPT port
CONFIG_PARPORT=n
# Gameport / legacy joystick interface — gaming uses USB HID
CONFIG_GAMEPORT=n
# PCMCIA / CardBus — desktop workstation, no card slots
CONFIG_PCCARD=n
CONFIG_CARDBUS=n

# ── Embedded / mobile / SoC display controllers ──────────────────────────────
# ARM / Qualcomm / Samsung / Allwinner SoC display engines — x86 only
CONFIG_DRM_MSM=n
CONFIG_DRM_MSFTQ=n
CONFIG_DRM_EXYNOS=n
CONFIG_DRM_ROCKCHIP=n
CONFIG_DRM_SUN4I=n
CONFIG_DRM_ETNAVIV=n
CONFIG_DRM_LIMA=n
CONFIG_DRM_PANFROST=n
CONFIG_DRM_TIDSS=n
CONFIG_DRM_HISI_HIBMC=n
# Aspeed / OpenPOWER BMC display — server BMC, not a workstation GPU
CONFIG_DRM_AST=n

# ── Old VGA / legacy display drivers ─────────────────────────────────────────
# Matrox G200/G400/G550 — not installed
CONFIG_DRM_MGA=n
# S3 Savage — not installed
CONFIG_DRM_SAVAGE=n
# Cirrus Logic — not installed (QEMU uses virtio-gpu anyway)
CONFIG_DRM_CIRRUS_QEMU=n
# SiS / XGI — not installed
CONFIG_DRM_SIS=n
CONFIG_DRM_XGI=n
# VIA / Chrome — not installed
CONFIG_DRM_VIA=n

# ── Serial / modem / infrared ─────────────────────────────────────────────────
# IRDA infrared subsystem — no IR hardware
CONFIG_IRDA=n
# Old RS-232 modems
CONFIG_MWAVE=n

# ── CAN bus ───────────────────────────────────────────────────────────────────
# Controller Area Network — no automotive/industrial interface
CONFIG_CAN=n

# ── IEEE 1394 / FireWire ──────────────────────────────────────────────────────
# No FireWire devices on this box
CONFIG_FIREWIRE=n

# ── SCSI tape / changer ───────────────────────────────────────────────────────
# No tape drives or media changers
CONFIG_CHR_DEV_ST=n
CONFIG_CHR_DEV_OSST=n
CONFIG_BLK_DEV_SR=n

# ── Unused filesystem types ───────────────────────────────────────────────────
# JFS — not used; ext4/btrfs/xfs cover everything
CONFIG_JFS_FS=n
# Minix FS — legacy; no use case
CONFIG_MINIX_FS=n
# QNX4/QNX6 — not needed
CONFIG_QNX4FS_FS=n
CONFIG_QNX6FS_FS=n
# Amiga FFS — not needed
CONFIG_AFFS_FS=n
# BeOS BFS — not needed
CONFIG_BEFS_FS=n
# Coda distributed FS — not used
CONFIG_CODA_FS=n

# ── Unused network filesystems ────────────────────────────────────────────────
# Ceph — not used in this setup; Ceph client adds kernel thread overhead
CONFIG_CEPH_FS=n

# ── Watchdog drivers (unused) ─────────────────────────────────────────────────
# Individual WDT cards — none of these are installed; software watchdog keeps
# the core CONFIG_WATCHDOG intact for VMs
CONFIG_ACQUIRE_WDT=n
CONFIG_ADVANTECH_WDT=n
CONFIG_WDT=n
