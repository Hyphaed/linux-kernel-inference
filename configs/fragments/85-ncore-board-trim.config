# requires-board: ASRock B760M-ITX/D4 WiFi
# ncore desktop trim: drivers and guest code for hardware this box does not have.
#
# Bound to ONE motherboard by the line above (configure.py::_required_board): any
# other machine running the wizard, Raptor Lake or not, skips this file, because
# it removes the NIC, Wi-Fi and storage drivers that machine may depend on.
# Decisions and what was rejected:
# workflow/decisions/ADR-011-kconfig-decisions-from-hardware-topology.md.
#
# Hardware this was derived from (lspci/lsmod, 2026-10-30): ASRock B760M-ITX/D4 WiFi,
# i9-14900KF, RTX 5070 (the only PCIe slot), Samsung NVMe, Realtek RTL8111 Ethernet,
# Intel CNVi WiFi + Bluetooth, HDA audio, no Thunderbolt/USB4 controller, no SCSI HBA.
#
# What this changes is build time, module count and attack surface. It does not
# change a runtime default, so it needs no tok/s A/B. Anything that could change
# behaviour (IOMMU default, PREEMPT_LAZY, THP defrag) is deliberately NOT here.
#
# To bring a driver back: delete its line here, re-run `python -m hyphaed --phase
# configure`, and `scripts/bump/50-config-audit.py` will confirm it took effect.

# -- Guest-OS support: this kernel only ever runs on bare metal ---------------
# (VMware Workstation and KVM are HOST features here; vmmon/vmnet/vmw_vmci stay.)
CONFIG_XEN=n
CONFIG_HYPERV=n
# TDX needs a TDX-capable Xeon/Core Ultra; the 14900KF has no TDX.
CONFIG_INTEL_TDX_HOST=n
CONFIG_KVM_INTEL_TDX=n

# -- Media hardware: no TV tuner, DVB, SDR or radio ---------------------------
# (Webcams stay: MEDIA_CAMERA_SUPPORT and USB_VIDEO_CLASS are untouched.)
CONFIG_MEDIA_DIGITAL_TV_SUPPORT=n
CONFIG_MEDIA_ANALOG_TV_SUPPORT=n
CONFIG_MEDIA_RADIO_SUPPORT=n
CONFIG_MEDIA_SDR_SUPPORT=n

# -- Lab / industrial / mobile hardware ---------------------------------------
CONFIG_COMEDI=n
CONFIG_INPUT_TOUCHSCREEN=n
CONFIG_INFINIBAND=n
# SCSI HBAs, RAID cards, iSCSI initiator. SATA (AHCI) and USB storage are not under this.
CONFIG_SCSI_LOWLEVEL=n
# No Thunderbolt/USB4 controller on this board (only a USB 3.2 Gen2x2 XHCI).
CONFIG_USB4=n

# -- Wi-Fi: the only radio is the Intel CNVi one (iwlwifi) ---------------------
CONFIG_WLAN_VENDOR_ADMTEK=n
CONFIG_WLAN_VENDOR_ATH=n
CONFIG_WLAN_VENDOR_ATMEL=n
CONFIG_WLAN_VENDOR_BROADCOM=n
CONFIG_WLAN_VENDOR_INTERSIL=n
CONFIG_WLAN_VENDOR_MARVELL=n
CONFIG_WLAN_VENDOR_MEDIATEK=n
CONFIG_WLAN_VENDOR_MICROCHIP=n
CONFIG_WLAN_VENDOR_PURELIFI=n
CONFIG_WLAN_VENDOR_QUANTENNA=n
CONFIG_WLAN_VENDOR_RALINK=n
CONFIG_WLAN_VENDOR_REALTEK=n
CONFIG_WLAN_VENDOR_RSI=n
CONFIG_WLAN_VENDOR_SILABS=n
CONFIG_WLAN_VENDOR_ST=n
CONFIG_WLAN_VENDOR_TI=n
CONFIG_WLAN_VENDOR_ZYDAS=n

# -- Ethernet: the only NIC is the Realtek RTL8111 (r8169). Intel is kept as a
# hedge for a future add-in card. USB Ethernet adapters live under USB_NET_DRIVERS
# and are untouched. NET_VENDOR_HISILICON is already n in the base config.
CONFIG_NET_VENDOR_3COM=n
CONFIG_NET_VENDOR_ADAPTEC=n
CONFIG_NET_VENDOR_AGERE=n
CONFIG_NET_VENDOR_ALACRITECH=n
CONFIG_NET_VENDOR_AMAZON=n
CONFIG_NET_VENDOR_AMD=n
CONFIG_NET_VENDOR_AQUANTIA=n
CONFIG_NET_VENDOR_ARC=n
CONFIG_NET_VENDOR_ASIX=n
CONFIG_NET_VENDOR_ATHEROS=n
CONFIG_NET_VENDOR_BROADCOM=n
CONFIG_NET_VENDOR_CADENCE=n
CONFIG_NET_VENDOR_CAVIUM=n
CONFIG_NET_VENDOR_CHELSIO=n
CONFIG_NET_VENDOR_CISCO=n
CONFIG_NET_VENDOR_CORTINA=n
CONFIG_NET_VENDOR_DAVICOM=n
CONFIG_NET_VENDOR_DEC=n
CONFIG_NET_VENDOR_DLINK=n
CONFIG_NET_VENDOR_EMULEX=n
CONFIG_NET_VENDOR_ENGLEDER=n
CONFIG_NET_VENDOR_EZCHIP=n
CONFIG_NET_VENDOR_FUNGIBLE=n
CONFIG_NET_VENDOR_GOOGLE=n
CONFIG_NET_VENDOR_HUAWEI=n
CONFIG_NET_VENDOR_LITEX=n
CONFIG_NET_VENDOR_MARVELL=n
CONFIG_NET_VENDOR_MELLANOX=n
CONFIG_NET_VENDOR_META=n
CONFIG_NET_VENDOR_MICREL=n
CONFIG_NET_VENDOR_MICROCHIP=n
CONFIG_NET_VENDOR_MICROSEMI=n
