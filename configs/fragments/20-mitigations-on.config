# All CPU vulnerability mitigations ON (locked by policy)
CONFIG_SPECULATION_MITIGATIONS=y
CONFIG_RETPOLINE=y
CONFIG_MITIGATION_RETPOLINE=y
CONFIG_MITIGATION_RETHUNK=y
CONFIG_MITIGATION_IBRS_ENTRY=y
CONFIG_MITIGATION_UNRET_ENTRY=y
CONFIG_MITIGATION_RFDS=y
CONFIG_MITIGATION_SPECTRE_BHI=y
CONFIG_MITIGATION_GDS_FORCE=n
CONFIG_MITIGATION_SLS=y
CONFIG_MITIGATION_SRSO=y
CONFIG_PAGE_TABLE_ISOLATION=y
CONFIG_INTEL_TSX_MODE_OFF=y
CONFIG_X86_KERNEL_IBT=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y

# Defense-in-depth for CVE-2026-31431 (algif_aead LPE, fixed upstream in this
# tree via a664bf3d603d) — this workstation has no direct AF_ALG AEAD socket
# consumer (dm-crypt/IPsec/userspace TLS use libcrypto, not this interface),
# so disabling it removes the attack surface entirely at zero functional cost.
CONFIG_CRYPTO_USER_API_AEAD=n

# ── ASLR entropy, pinned rather than patched (2026-08-27) ───────────────────
# linux-tkg's 7.2 set carries a patch flipping arch/Kconfig's
# ARCH_MMAP_RND_BITS default from _MIN to _MAX, to mitigate the ASLRnt work
# (https://zolutal.github.io/aslrnt/). We do not need the patch: on x86_64
# ARCH_MMAP_RND_BITS_MAX is 32 (arch/x86/Kconfig:363, `default 32 if 64BIT`)
# and Canonical's base config already sets 32.
#
# Pinned anyway, for the reason this file exists. The upstream *default* is
# still _MIN; we are at _MAX purely because Ubuntu's base says so, which is
# the same "fine by luck" footing CLAUDE.md records for ITMT and HFI. One
# line makes it ours.
#
# The prompt is gated `if EXPERT`, which is what the tkg patch works around;
# a fragment assignment is not affected by the prompt being hidden.
CONFIG_ARCH_MMAP_RND_BITS=32
CONFIG_ARCH_MMAP_RND_COMPAT_BITS=16
