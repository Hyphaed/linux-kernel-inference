# Ubuntu 26.04 LTS ("resolute") boot-critical requirements.
# These are seeded from the base config but explicitly pinned here so any
# fragment that accidentally disables them is caught at configure-time
# (kconfig.py floor validation) and not discovered as a kernel panic at boot.
#
# Rule: never disable any line in this file without updating UBUNTU_BOOT_FLOOR
#       in hyphaed/kconfig.py and adding a regression test in tests/test_kconfig.py.

# ── initramfs decompression ──────────────────────────────────────────────────
# Ubuntu 26.04 dracut generates zstd-compressed initramfs by default.
# Missing CONFIG_RD_ZSTD = "Cannot decompress initramfs" panic before any
# userspace runs.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_ZSTD=y
# Keep a legacy fallback for older initrds on the same /boot
CONFIG_RD_BZIP2=y
CONFIG_RD_LZMA=y
CONFIG_RD_XZ=y
CONFIG_RD_LZO=y
CONFIG_RD_LZ4=y

# ── /dev initialisation ──────────────────────────────────────────────────────
# Without DEVTMPFS_MOUNT the kernel cannot auto-populate /dev during early
# boot and the initramfs fails to find device nodes → VFS mount panic.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# ── OverlayFS + SquashFS ─────────────────────────────────────────────────────
# OverlayFS=m: required for snap packages (snapd uses overlayfs for confinement)
# and systemd-tmpfiles / container runtimes. Ubuntu 26.04 snapd breaks at
# runtime without it.
# SquashFS=y: snap .snap files are squashfs images; without this snaps cannot
# be mounted at all.
CONFIG_OVERLAY_FS=m
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_LZO=y
CONFIG_SQUASHFS_ZLIB=y

# ── Build compatibility overrides ────────────────────────────────────────────
# Ubuntu's base config points these at files that only exist in Canonical's own
# kernel source tree (debian/canonical-*.pem). XanMod has no such files, so
# the build fails with "No rule to make target" if these are left set.
# Empty string = no extra keys embedded; the auto-generated signing_key.pem
# (for CONFIG_MODULE_SIG_KEY) is unaffected.
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""

# ── EFI runtime services ─────────────────────────────────────────────────────
# Required for UEFI boot on modern hardware; without this the EFI stub cannot
# hand off properly and some firmware panics on entry.
CONFIG_EFI=y
CONFIG_EFI_STUB=y

# ── kexec handover: inherited from Ubuntu, fails on every boot ───────────────
# Ubuntu's base config ships CONFIG_KEXEC_HANDOVER=y with
# KEXEC_HANDOVER_ENABLE_DEFAULT=y. KHO needs a `kho_scratch=` boot parameter to
# reserve its scratch area; we don't pass one, so every boot prints
#
#   KHO: Failed to reserve lowmem scratch buffer
#   KHO: Failed to reserve scratch area, disabling kexec handover
#
# and turns itself off. /sys/kernel/kho never appears. Nothing here uses kexec
# handover — kdump uses ordinary `kexec -p`, which is CONFIG_KEXEC/KEXEC_FILE
# and is unaffected. Verified on 7.1.10: nothing `select`s KEXEC_HANDOVER, and
# it carries its own prompt, so =n sticks.
CONFIG_KEXEC_HANDOVER=n

# CMA is pinned because of the line above — but not for the reason it first
# looks like, and the difference was measured rather than reasoned.
#
# On x86 the only thing that selects CONFIG_CMA is KEXEC_HANDOVER
# (kernel/liveupdate/Kconfig:13); every other selector is s390, powerpc, arm,
# etnaviv or aspeed. So turning KHO off removes CMA's only selector here, and
# if CMA fell it would cascade:
#
#   CMA=n  ->  DMA_CMA=n (depends on HAVE_DMA_CONTIGUOUS && CMA)
#          ->  DMABUF_HEAPS_CMA=n (depends on DMABUF_HEAPS && DMA_CMA)
#
# **It does not fall.** Tested 2026-08-27 on 7.1.10 by commenting these three
# lines out and re-running configure: all three stayed =y. `olddefconfig`
# carries forward the =y inherited from Canonical's base config, so the select
# was never the only thing holding CMA on — the same behaviour CLAUDE.md
# already records for X86_AMD_PSTATE.
#
# They stay pinned anyway, for one reason: that survival depends entirely on
# the base config we happen to merge onto. The day Canonical's mainline build
# stops setting CONFIG_CMA=y, KHO=n becomes the thing that silently removes a
# dma-buf heap from a machine built around dma-buf, and nothing would report
# it — 70-greenboost-required.config pins DMABUF_HEAPS but not the CMA heap.
# Three lines to make that impossible is a good trade.
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_DMABUF_HEAPS_CMA=y
