# Ubuntu 26.04 LTS ("resolute") boot-critical requirements.
# These are seeded from the base config but explicitly pinned here so any
# fragment that accidentally disables them is caught at configure-time
# (kconfig.py floor validation) and not discovered as a kernel panic at boot.
#
# Rule: never disable any line in this file without updating UBUNTU_BOOT_FLOOR
#       in hyphaed/kconfig.py and adding a regression test in tests/test_kconfig.py.

# ── initramfs decompression ──────────────────────────────────────────────────
# Ubuntu 26.04 dracut generates zstd-compressed initramfs by default.
# Missing CONFIG_RD_ZSTD = "Cannot decompress initramfs" panic before any
# userspace runs.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_ZSTD=y
# Keep a legacy fallback for older initrds on the same /boot
CONFIG_RD_BZIP2=y
CONFIG_RD_LZMA=y
CONFIG_RD_XZ=y
CONFIG_RD_LZO=y
CONFIG_RD_LZ4=y

# ── /dev initialisation ──────────────────────────────────────────────────────
# Without DEVTMPFS_MOUNT the kernel cannot auto-populate /dev during early
# boot and the initramfs fails to find device nodes → VFS mount panic.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# ── OverlayFS + SquashFS ─────────────────────────────────────────────────────
# OverlayFS=m: required for snap packages (snapd uses overlayfs for confinement)
# and systemd-tmpfiles / container runtimes. Ubuntu 26.04 snapd breaks at
# runtime without it.
# SquashFS=y: snap .snap files are squashfs images; without this snaps cannot
# be mounted at all.
CONFIG_OVERLAY_FS=m
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_LZO=y
CONFIG_SQUASHFS_ZLIB=y

# ── Build compatibility overrides ────────────────────────────────────────────
# Ubuntu's base config points these at files that only exist in Canonical's own
# kernel source tree (debian/canonical-*.pem). XanMod has no such files, so
# the build fails with "No rule to make target" if these are left set.
# Empty string = no extra keys embedded; the auto-generated signing_key.pem
# (for CONFIG_MODULE_SIG_KEY) is unaffected.
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""

# ── EFI runtime services ─────────────────────────────────────────────────────
# Required for UEFI boot on modern hardware; without this the EFI stub cannot
# hand off properly and some firmware panics on entry.
CONFIG_EFI=y
CONFIG_EFI_STUB=y
